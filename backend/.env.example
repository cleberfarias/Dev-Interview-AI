# Backend (FastAPI)
PORT=8000
CORS_ORIGINS=http://localhost:5000,https://YOUR_PROJECT.web.app,https://YOUR_PROJECT.firebaseapp.com
DEFAULT_CREDITS=3
FREE_TRIAL_CREDITS=1
CREDITS_NAME_EXTRACT=1
CREDITS_TTS=1
INTERVIEW_MIN_MINUTES=10
INTERVIEW_MAX_MINUTES_FREE=15
INTERVIEW_MAX_MINUTES_PRO=25

# Gemini (Google AI Studio)
GEMINI_API_KEY=...

# Firebase Admin credentials (choose ONE)
# Option 1: path to service account file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Option 2: JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# DEV endpoint for adding credits
ALLOW_DEV_CREDITS=false

# AI Router providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER_ORDER=openai,groq
AI_PROVIDER_ORDER_MEDIA=gemini,openai,groq
AI_MODEL_PLAN=openai:gpt-4o-mini
AI_MODEL_FAST=openai:gpt-4.1-nano
AI_MODEL_REPORT=openai:gpt-4o-mini
AI_MODEL_FALLBACK_GEMINI=gemini:gemini-1.5-mini
AI_MODEL_FALLBACK_GROQ=groq:llama-3.1-8b-instant
AI_MODEL_FALLBACK_OPENAI=openai:gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Live coach STT options: auto | openai | disabled
LIVE_COACH_STT_PROVIDER=auto
# Timeout for live coach transcription calls (seconds)
LIVE_COACH_STT_TIMEOUT=45

# MCP (Model Context Protocol)
# MCP HTTP access requires Authorization: Bearer <Firebase ID token>
# MCP server URL (local: http://127.0.0.1:8000/mcp, Cloud Run: http://127.0.0.1:8080/mcp)
MCP_SERVER_URL=
# MCP HTTP timeout in seconds (default 5)
MCP_HTTP_TIMEOUT=5
# If true, include rubric context in evaluation prompts
MCP_CONTEXT_ENABLED=false

# Kiwify webhook (optional)
# Token to validate webhook requests (sent as header x-kiwify-token or query ?token=)
KIWIFY_WEBHOOK_TOKEN=
# For local-only debugging without token (unsafe, keep false in production)
ALLOW_UNSECURED_KIWIFY_WEBHOOK=false
# Enable test webhook route /webhooks/kiwify/test (keep false in production)
ALLOW_KIWIFY_TEST_WEBHOOK=false
# JSON mapping of product id/name to credits
# Example: {"pack_3":3,"pack_10":10,"pack_100":100,"Pack 3":3,"Pack 10":10,"Pack 100":100}
KIWIFY_PRODUCT_CREDITS=
