# Frontend (Vite)
VITE_API_BASE_URL=/api
# (local dev) VITE_API_BASE_URL=http://localhost:8000

# Firebase Web App config (Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=...
VITE_FIREBASE_PROJECT_ID=...
VITE_FIREBASE_STORAGE_BUCKET=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...

# Interview limits (must match backend defaults)
VITE_INTERVIEW_MIN_MINUTES=10
VITE_INTERVIEW_MAX_MINUTES_FREE=15
VITE_INTERVIEW_MAX_MINUTES_PRO=25
